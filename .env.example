# OpenRouter — every candidate model and the judge are called through this.
OPENROUTER_API_KEY=

# Optional additional marketplaces a project can choose to search
# (`project create --providers openrouter,groq`). Their model-list APIs may
# not publish price/JSON-mode support the way OpenRouter's does — those
# fields come back unknown rather than guessed, so such models are excluded
# by the price guardrail until/unless that changes.
GROQ_API_KEY=
FIREWORKS_API_KEY=

# Where a "pending candidate" notification is emailed, if not set per use case.
MODELCICD_NOTIFY_EMAIL=

# SMTP, for notify.py. Left unset, the CLI prints the approve command instead
# of emailing it.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=modelcicd@localhost
SMTP_STARTTLS=1

# Leave unset for the usual localhost-only workflow — nothing changes. Set
# this (`cli set-dashboard-key`, or the dashboard's own "API keys" page) and
# every dashboard page and the /api/* routes start requiring it — needed
# once `cli ui` is reachable by anything other than your own machine.
MODELCICD_API_KEY=
